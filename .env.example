# Copy thành .env (đã gitignore) và điền. `vn` tự nạp khi import.

# LLM backend cho analyze/advise/tcbs
VN_LLM_BACKEND=claude-cli        # claude-cli (subscription) | api (ANTHROPIC_API_KEY) | off
VN_LLM_MODEL=sonnet              # sonnet|haiku|opus (cli) hoặc claude-sonnet-4-6… (api)
# ANTHROPIC_API_KEY=sk-ant-...   # nếu dùng backend api

# everyday API (holdings + số dư ví cho `advise --cash-wallet` / `portfolio`)
EVERYDAY_API_BASE=https://your-everyday-host        # URL API everyday (HTTPS public)
EVERYDAY_ADMIN_TOKEN=your-admin-token
